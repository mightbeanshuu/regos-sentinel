    {
      "id": "fix_story",
      "kind": "fixstory",
      "clip": null,
      "clipStart": 0,
      "label": "Caught, fixed, cleared",
      "captions": true,
      "startFrame": 3103,
      "durationFrames": 1660,
      "lines": [
        {
          "text": "Here's that paragraph on its own.",
