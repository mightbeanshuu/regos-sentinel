      "clip": "decide",
      "clipStart": 12,
      "label": "A named decision",
      "startFrame": 2395,
      "durationFrames": 534,
      "lines": [
        {
          "text": "The decision belongs to a named officer, and the order it happens in matters.",
          "src": "audio/decide-0.wav",
          "startFrame": 0,
          "durationFrames": 126
        },
        {
          "text": "You can't record a reading until every section the answer leans on has been opened and fingerprinted.",
