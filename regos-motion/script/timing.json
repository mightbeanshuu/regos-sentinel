      "captions": true,
      "startFrame": 6419,
      "durationFrames": 731,
      "lines": [
        {
          "text": "Before it asks you to trust anything, it shows you what it does.",
          "src": "audio/howitworks-0.wav",
          "startFrame": 0,
          "durationFrames": 228
        },
        {
          "text": "Fetch the SEBI source, read it, compare it to the firm's control, record a decision.",
