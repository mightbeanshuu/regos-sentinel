          "startFrame": 561,
          "durationFrames": 122
        }
      ]
    },
    {
      "id": "model",
      "kind": "model",
      "clip": null,
      "clipStart": 0,
      "label": "The model",
      "captions": true,
      "startFrame": 7150,
      "durationFrames": 1253,
      "lines": [
        {
          "text": "The reading itself is a classifier we trained, on three hundred and eighty-eight sentences of real SEBI wording.",
          "src": "audio/model-0.wav",
          "startFrame": 0,
          "durationFrames": 380
        },
        {
          "text": "It weighs what actually decides the answer. A length of time with nothing to start it counts for more than almost anything else.",
          "src": "audio/model-1.wav",
          "startFrame": 398,
          "durationFrames": 417
        },
        {
          "text": "And a fixed rule reads the same sentence separately. Where the two disagree, the disagreement is what you get shown.",
          "src": "audio/model-2.wav",
          "startFrame": 834,
          "durationFrames": 371
        }
      ]
    },
